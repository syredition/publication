<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Artist Intelligence — SYR Edition</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=DM+Sans:wght@300;400;500&family=Noto+Sans+KR:wght@300;400;500&family=Noto+Serif+KR:wght@300;400&display=swap" rel="stylesheet">
<style>
  :root {
    --navy:#1C3F7A; --deep:#0A2240; --text:#1A1A2E;
    --muted:#6B7280; --rule:#CCCCCC; --accent:#C8983A;
    --cream:#F9F8F6;
    --fd:'Cormorant Garamond','Noto Serif KR',Georgia,serif;
    --fb:'DM Sans','Noto Sans KR',-apple-system,sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{font-family:var(--fb);font-weight:300;color:var(--text);background:#fff;
    word-break:keep-all;overflow-wrap:break-word;font-size:15px;line-height:1.7}
  a{color:var(--navy);text-decoration:none}
  a:hover{border-bottom:1px solid var(--navy)}

  /* ── MASTHEAD ─────────────────────────── */
  .masthead{padding:3rem 6vw 2rem;border-bottom:2px solid var(--deep)}
  .masthead-label{font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;
    color:var(--muted);margin-bottom:.5rem}
  .masthead-title{font-family:var(--fd);font-weight:300;font-size:clamp(2rem,4vw,3.2rem);
    color:var(--deep);line-height:1;margin-bottom:.4rem}
  .masthead-sub{font-size:.82rem;color:var(--muted)}

  /* ── INDEX ────────────────────────────── */
  .index{padding:1.5rem 6vw;border-bottom:1px solid var(--rule);
    display:flex;flex-wrap:wrap;gap:.4rem .75rem;font-size:.72rem;
    letter-spacing:.06em;color:var(--muted)}
  .index a{color:var(--muted)}
  .index a:hover{color:var(--deep);border-bottom:none}
  .index-num{color:var(--rule)}

  /* ── ARTIST ENTRY ─────────────────────── */
  .artist{padding:3rem 6vw;border-bottom:1px solid var(--rule)}
  .artist:target{background:var(--cream)}

  .artist-header{display:flex;align-items:baseline;gap:1.5rem;margin-bottom:1.75rem;flex-wrap:wrap}
  .artist-num{font-family:var(--fd);font-weight:300;font-size:3rem;color:var(--rule);line-height:1;flex-shrink:0}
  .artist-nameblock{}
  .artist-name{font-family:var(--fd);font-weight:600;font-size:clamp(1.5rem,2.8vw,2.2rem);
    color:var(--deep);line-height:1;margin-bottom:.25rem}
  .artist-meta{font-size:.78rem;color:var(--muted);letter-spacing:.04em}
  .artist-tag{display:inline-block;font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;
    border:1px solid var(--rule);color:var(--muted);padding:2px 8px;border-radius:10px;
    margin-right:4px;margin-top:4px}

  /* ── FIELDS ───────────────────────────── */
  .fields{display:grid;gap:0}
  .field{display:grid;grid-template-columns:120px 1fr;gap:1rem;
    padding:.65rem 0;border-bottom:1px solid var(--rule)}
  .field:last-child{border-bottom:none}
  .field-label{font-size:.6rem;letter-spacing:.12em;text-transform:uppercase;
    color:var(--muted);padding-top:3px;font-weight:500}
  .field-value{font-size:.875rem;color:var(--text);line-height:1.7}
  .field-value.serif{font-family:var(--fd);font-style:italic;font-size:1rem;line-height:1.75}

  /* exhibitions list */
  .exh-list{list-style:none;display:flex;flex-direction:column;gap:.35rem}
  .exh-item{font-size:.85rem;line-height:1.5}
  .exh-year{font-family:var(--fd);font-weight:600;color:var(--accent);
    margin-right:.5rem;font-size:.95rem}
  .exh-venue{color:var(--muted);font-size:.78rem}

  /* price table */
  .price-table{width:100%;border-collapse:collapse;font-size:.82rem}
  .price-table th{text-align:left;font-size:.58rem;letter-spacing:.1em;
    text-transform:uppercase;color:var(--muted);font-weight:400;
    border-bottom:1px solid #999;padding:.35rem .5rem .35rem 0}
  .price-table td{padding:.45rem .5rem .45rem 0;border-bottom:1px solid var(--rule);
    vertical-align:top}
  .price-table td:first-child{color:var(--accent);font-family:var(--fd);font-weight:600;font-size:.95rem}
  .price-note{font-size:.72rem;color:var(--muted);margin-top:.6rem;font-style:italic}

  /* links */
  .link-row{display:flex;gap:.75rem;flex-wrap:wrap;align-items:center}
  .link-btn{font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;
    border:1px solid var(--rule);color:var(--muted);padding:.25rem .75rem;border-radius:2px}
  .link-btn:hover{border-color:var(--navy);color:var(--navy)}
  .link-btn.primary{border-color:var(--navy);color:var(--navy)}

  /* footer */
  footer{padding:1.5rem 6vw;font-size:.62rem;color:var(--muted);
    border-top:1px solid var(--rule);display:flex;justify-content:space-between;flex-wrap:wrap;gap:.5rem}

  /* responsive */
  @media(max-width:680px){
    .field{grid-template-columns:1fr;gap:.25rem}
    .field-label{padding-top:0}
    .artist-num{font-size:2rem}
    .price-table{font-size:.75rem}
  }

  /* ── ARTWORK IMAGES ─────────────────────────────── */
  .artwork-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
    gap:1.5rem;margin:.25rem 0}
  .artwork-fig{margin:0;display:flex;flex-direction:column;gap:.5rem}
  .artwork-img-wrap{background:var(--cream);overflow:hidden;border-radius:1px;
    display:flex;align-items:center;justify-content:center;min-height:180px}
  .artwork-img-wrap img{width:100%;height:auto;max-height:460px;object-fit:contain;display:block}
  .img-fail{padding:2rem;font-size:.72rem;color:var(--muted);text-align:center;width:100%}
  figcaption{padding:.6rem 0 0;border-top:1px solid var(--rule)}
  .artwork-caption{font-family:var(--fd);font-style:italic;font-size:.85rem;
    line-height:1.6;color:var(--text);margin-bottom:.35rem}
  .artwork-meta{display:flex;justify-content:space-between;align-items:flex-start;
    gap:.75rem;flex-wrap:wrap}
  .artwork-copyright{font-size:.62rem;color:var(--muted);line-height:1.5;flex:1}
  .artwork-source{font-size:.62rem;color:var(--navy);border-bottom:1px solid var(--rule);
    white-space:nowrap;flex-shrink:0}
  .artwork-source:hover{color:var(--deep)}
  @media(max-width:600px){
    .artwork-grid{grid-template-columns:1fr}
    .artwork-img-wrap{min-height:140px}
  }

</style>
